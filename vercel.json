{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/backend-api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 3008,
      "includeFiles": [
        "../api/**",
        "../idss_agent/**",
        "../config/**",
        "../data/**",
        "../requirements.txt"
      ]
    }
  },
  "env": {
    "PYTHONPATH": "/var/task/.."
  }
}
