{
  "version": 2,
  "buildCommand": "cd .. && cp -r api idss_agent config data requirements.txt web/ 2>/dev/null || true && cd web && npm install && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/backend-api/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "memory": 3008
    }
  },
  "env": {
    "PYTHONPATH": "/var/task"
  }
}
