{
  "version": 2,
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/.next",
  "installCommand": "cd web && npm install",
  "rewrites": [
    {
      "source": "/backend-api/(.*)",
      "destination": "/api/backend/index.py"
    }
  ],
  "functions": {
    "api/backend/index.py": {
      "maxDuration": 300,
      "memory": 3008
    }
  },
  "env": {
    "PYTHONPATH": "/var/task"
  }
}
