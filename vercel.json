{
  "version": 2,
  "buildCommand": "npm install && npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/backend-api/(.*)",
      "destination": "/../api/backend/index.py"
    }
  ],
  "functions": {
    "../api/backend/index.py": {
      "maxDuration": 300,
      "memory": 3008
    }
  },
  "env": {
    "PYTHONPATH": "/var/task"
  }
}
